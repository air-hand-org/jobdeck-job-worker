{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>aquaproj/aqua-renovate-config#2.13.0",
    "helpers:pinGitHubActionDigestsToSemver",
    "config:recommended",
    ":semanticCommits"
  ],
  "prConcurrentLimit": 10,
  "enabledManagers": [
    "custom.regex",
    "mise",
    "github-actions",
    "gomod",
    "dockerfile"
  ],
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "auto",
  "gitIgnoredAuthors": [
    "air-hand-release-app[bot]@users.noreply.github.com"
  ],
  "vulnerabilityAlerts": {
    "automerge": false
  },
  "lockFileMaintenance": {
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Consume internally controlled api-contracts Go modules without an additional delay",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "/^github\\.com/air-hand-org/api-contracts(?:/|$)/"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Consume internally controlled jobdeck-actions releases without an additional delay",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "air-hand-org/jobdeck-actions"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Update mise Go version with go.mod Go directive",
      "matchManagers": [
        "mise"
      ],
      "matchDepNames": [
        "go"
      ],
      "groupName": "Go",
      "groupSlug": "go",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Update go.mod Go directive with mise Go version",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "groupName": "Go",
      "groupSlug": "go",
      "rangeStrategy": "bump",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy",
        "gomodUpdateImportPaths"
      ]
    }
  ],
  "mise": {
    "managerFilePatterns": [
      "(^|/)\\.?mise\\.toml$",
      "(^|/)\\.?mise/config\\.toml$",
      "(^|/)\\.?mise/config.*\\.toml$"
    ]
  },
  "assigneesFromCodeOwners": true
}
